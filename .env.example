# ─────────────────────────────────────────────
#  Customer Churn Intelligence Platform — .env
# ─────────────────────────────────────────────

# Database (SQLite for local dev; swap to PostgreSQL connection string for prod)
DATABASE_URL=sqlite:///data/churn.db

# LLM Provider — Anthropic Claude (default)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model name passed to Anthropic API. Change here to switch model versions.
AI_MODEL_NAME=claude-sonnet-4-6

# ─── To swap to PostgreSQL ────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/churn_db
